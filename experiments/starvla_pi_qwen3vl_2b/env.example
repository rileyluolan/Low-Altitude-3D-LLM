# Copy to env.local. All variables are optional except CUDA_HOME during install.
# Defaults keep sources, environments and outputs inside this experiment.
# Use absolute paths when overriding. Do not point STARVLA_ROOT at a running job.

# CONDA_BIN=/path/to/miniconda3/bin/conda
# CUDA_HOME=/path/to/cuda-12.4
# CC=/usr/bin/gcc
# CXX=/usr/bin/g++
# TORCH_CUDA_ARCH_LIST=8.0

# Existing large inputs can be shared read-only:
# MODEL_ROOT=/path/to/Qwen3-VL-2B-Instruct
# HUGE_DATA_ROOT=/path/to/HUGE_data
# BASE_CKPT=/path/to/mature_base/checkpoints/base_pytorch_model.pt
# VENV_ROOT=/path/to/python310-environment

# TRAIN_GPUS=0,1,2,3
# OXE_NUM_PROCESSES=4
# RUN_ID=hugebench_qwen3vl2b_5ep_b512
# SEED=42
