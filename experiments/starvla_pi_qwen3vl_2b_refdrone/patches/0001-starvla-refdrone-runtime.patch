+        if bool(self.data_cfg.get("filter_trajectories_to_cached_steps", False)):
+            # `_get_all_steps` omits episodes with empty language, but the mixture
+            # sampler historically sampled from the unfiltered episode metadata.
+            # Opt in to the same episode population represented by the cache so
+            # dataset sampling and recorded source statistics stay consistent.
+            valid_trajectory_ids = {trajectory_id for trajectory_id, _ in self._all_steps}
