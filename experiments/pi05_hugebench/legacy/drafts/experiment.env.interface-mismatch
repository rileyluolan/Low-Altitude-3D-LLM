#!/usr/bin/env bash
# Canonical paths and immutable experiment identity for pi0.5 on HUGE-Bench.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT="$(cd "${CONFIG_DIR}/.." && pwd)"
export WORKSPACE_ROOT="$(cd "${PROJECT_ROOT}/../.." && pwd)"

export EXPERIMENT_NAME="pi05_hugebench"
export TRAIN_CONFIG="pi05_overall"
export RUN_NAME="pi05_overall_run1"
export BASE_WEIGHTS_URI="gs://openpi-assets/checkpoints/pi05_base/params"

export XPOLICYLAB_ROOT="${WORKSPACE_ROOT}/XPolicyLab"
export OPENPI_ROOT="${XPOLICYLAB_ROOT}/policy/Pi_05/openpi"
export HUGEBENCH_ROOT="${WORKSPACE_ROOT}/HUGE-Bench"
export GAUSSIAN_SPLATTING_ROOT="${WORKSPACE_ROOT}/gaussian-splatting"
export HUGE_DATA_ROOT="${WORKSPACE_ROOT}/HUGE_data"

export DATA_ROOT="${PROJECT_ROOT}/data"
export LEROBOT_HOME="${DATA_ROOT}/lerobot_home"
export ARTIFACT_ROOT="${PROJECT_ROOT}/artifacts"
export CHECKPOINTS_ROOT="${ARTIFACT_ROOT}/checkpoints"
export ASSETS_ROOT="${ARTIFACT_ROOT}/assets"
export OPENPI_CACHE_DIR="${ARTIFACT_ROOT}/cache"
export TRAINED_CHECKPOINT_ROOT="${CHECKPOINTS_ROOT}/${TRAIN_CONFIG}/${RUN_NAME}"
export RESULTS_ROOT="${PROJECT_ROOT}/results"
export LOGS_ROOT="${PROJECT_ROOT}/logs"

export HF_LEROBOT_HOME="${LEROBOT_HOME}"
export HF_HOME="${OPENPI_CACHE_DIR}/huggingface"
export XDG_CACHE_HOME="${OPENPI_CACHE_DIR}"
export JAX_COMPILATION_CACHE_DIR="${OPENPI_CACHE_DIR}/jax_cache"
export PYTHONPATH="${OPENPI_ROOT}/src:${HUGEBENCH_ROOT}:${GAUSSIAN_SPLATTING_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

# Runtime overrides may be exported before invoking a script.
export ACTION_SERVER_HOST="${ACTION_SERVER_HOST:-127.0.0.1}"
export ACTION_SERVER_PORT="${ACTION_SERVER_PORT:-8000}"
export RENDERER_START_PORT="${RENDERER_START_PORT:-8100}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
export SEED="${SEED:-0}"

