+@dataclasses.dataclass(frozen=True)
+class MyDroneDataConfig(DataConfigFactory):
+    """
+    DataConfig for the custom UAV LeRobot dataset.
+    This configuration currently uses the current image and the first frame of the episode as inputs at each step.
+    """
+
+    # Keep this switch if you need an additional delta transform.
+    extra_delta_transform: bool = False
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        # 1) Map LeRobot dataset keys to the shared training and inference keys.
+        # During training, the LeRobot dataset provides image / first_image / state / actions / task.
+        # During inference, the policy server should receive observation/image + observation/first_image + observation/state (+ prompt).
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        # OpenPI expected key : corresponding key in the LeRobot dataset
+                        "observation/image": "image",
+                        "observation/first_image": "first_image",  # Added first frame input
+                        "observation/state": "state",
+                        "actions": "actions",
+                        "prompt": "task",  # The dataset uses the task field
+                    }
+                )
+            ]
+        )
+
+        # 2) Use DroneInputs/DroneOutputs for both dataset processing and inference.
+        data_transforms = _transforms.Group(
+            inputs=[drone_policy.DroneInputs(model_type=model_config.model_type)],
+            outputs=[drone_policy.DroneOutputs()],
+        )
+
+        # 3) Optionally add an extra delta transform, depending on whether actions are absolute or delta.
+        if self.extra_delta_transform:
+            delta_action_mask = _transforms.make_bool_mask(4, -1)
+            data_transforms = data_transforms.push(
+                inputs=[_transforms.DeltaActions(delta_action_mask)],
+                outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+            )
+
+        # 4) Keep the model transforms unchanged.
+        model_transforms = ModelTransformFactory()(model_config)
+
+        # 5) Return the assembled data config.
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
+
